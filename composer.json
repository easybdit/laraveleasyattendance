{
    "name": "easybdit/laraveleasyattendance",
    "description": "Drop-in attendance tracking (check-in/out, corrections, reports) for any Laravel application.",
    "keywords": ["laravel", "attendance", "hr", "check-in", "timesheet"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Md Murad Hosen",
            "email": "muradbd.info@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0"
    },
    "suggest": {
        "codinglibs/zkteco-php": "Required for pull-mode device sync (connecting out to a ZKTeco device's IP). Not needed for push/ADMS mode."
    },
    "autoload": {
        "psr-4": {
            "Easybdit\\LaravelEasyAttendance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Easybdit\\LaravelEasyAttendance\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Easybdit\\LaravelEasyAttendance\\LaravelEasyAttendanceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
