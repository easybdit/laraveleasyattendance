parameters:
	ignoreErrors:
		-
			message: '#^Call to an undefined method Illuminate\\Foundation\\Auth\\User\:\:attendanceOn\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Http/Controllers/AttendanceController.php

		-
			message: '#^Call to an undefined method Illuminate\\Foundation\\Auth\\User\:\:checkIn\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Http/Controllers/AttendanceController.php

		-
			message: '#^Call to an undefined method Illuminate\\Foundation\\Auth\\User\:\:checkOut\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Http/Controllers/AttendanceController.php

		-
			message: '#^Call to an undefined method Illuminate\\Foundation\\Auth\\User\:\:attendanceCorrections\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Http/Controllers/AttendanceCorrectionController.php

		-
			message: '#^Call to an undefined method Illuminate\\Foundation\\Auth\\User\:\:requestAttendanceCorrection\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: src/Http/Controllers/AttendanceCorrectionController.php

		-
			message: '#^Parameter \#1 \$view of function view expects view\-string\|null, string given\.$#'
			identifier: argument.type
			count: 2
			path: src/Http/Controllers/AttendancePrintController.php

		-
			message: '#^Call to an undefined method Illuminate\\Database\\Eloquent\\Model\:\:attendances\(\)\.$#'
			identifier: method.notFound
			count: 2
			path: src/Models/AttendanceCorrection.php

		-
			message: '#^Method Easybdit\\LaravelEasyAttendance\\Models\\Employee\:\:recordPunch\(\) should return Easybdit\\LaravelEasyAttendance\\Models\\Attendance but returns Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: return.type
			count: 1
			path: src/Models/Employee.php

		-
			message: '#^Method Easybdit\\LaravelEasyAttendance\\Models\\Employee\:\:requestAttendanceCorrection\(\) should return Easybdit\\LaravelEasyAttendance\\Models\\AttendanceCorrection but returns Illuminate\\Database\\Eloquent\\Model\.$#'
			identifier: return.type
			count: 1
			path: src/Models/Employee.php

		-
			message: '#^Parameter \#1 \$attendance of class Easybdit\\LaravelEasyAttendance\\Events\\AttendanceRecorded constructor expects Easybdit\\LaravelEasyAttendance\\Models\\Attendance, Illuminate\\Database\\Eloquent\\Model given\.$#'
			identifier: argument.type
			count: 1
			path: src/Models/Employee.php

		-
			message: '#^Parameter \#1 \$correction of class Easybdit\\LaravelEasyAttendance\\Events\\AttendanceCorrectionRequested constructor expects Easybdit\\LaravelEasyAttendance\\Models\\AttendanceCorrection, Illuminate\\Database\\Eloquent\\Model given\.$#'
			identifier: argument.type
			count: 1
			path: src/Models/Employee.php

		-
			message: '#^Parameter \#1 \$punches of static method Easybdit\\LaravelEasyAttendance\\Models\\Attendance\:\:resolveDayWindow\(\) expects Illuminate\\Support\\Collection\<int, Easybdit\\LaravelEasyAttendance\\Models\\Attendance\>, Illuminate\\Database\\Eloquent\\Collection\<int, Illuminate\\Database\\Eloquent\\Model\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Models/Employee.php

		-
			message: '#^Parameter \#1 \$punches of static method Easybdit\\LaravelEasyAttendance\\Models\\Attendance\:\:resolveDayWindow\(\) expects Illuminate\\Support\\Collection\<int, Easybdit\\LaravelEasyAttendance\\Models\\Attendance\>, Illuminate\\Database\\Eloquent\\Collection\<int, Illuminate\\Database\\Eloquent\\Model\> given\.$#'
			identifier: argument.type
			count: 1
			path: src/Services/AttendanceSummaryService.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: src/Support/ShiftResolver.php
